{
  // Cloudflare publica solo la carpeta public/ como sitio estático
  "name": "bakery-side-pedidos",
  // Worker: escribe el menú dentro del HTML para Google y la IA (ver src/worker.js)
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": true,
  // Dominio propio de la tienda
  "routes": [
    { "pattern": "thebakeryside.com", "custom_domain": true },
    { "pattern": "www.thebakeryside.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  }
}
